DATABASE_URL=postgres://user:password@host/dbname
PAYLOAD_SECRET=YOUR_SECRET_HERE
BLOB_READ_WRITE_TOKEN=YOUR_VERCEL_BLOB_TOKEN_HERE

# Login/registratie (zie technische-architectuur-schets.md -> Frontend: Login & registratie)
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
# Optioneel: pas alleen aan zodra een eigen domein bij Resend geverifieerd is, anders werkt de
# standaard Resend-testafzender (onboarding@resend.dev) alleen naar het eigen Resend-account.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Basis-URL van de site, voor links in verificatie-/wachtwoord-reset-e-mails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
